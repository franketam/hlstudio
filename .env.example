# --- Database (Postgres) ---
# Local dev (matches docker-compose.yml — host port 5433):
#   postgresql://hlstudio:hlstudio@localhost:5433/hlstudio
# Production (Coolify): use the connection string Coolify gives you for the Postgres service.
DATABASE_URL=postgresql://hlstudio:hlstudio@localhost:5433/hlstudio

# --- Auth (admin único MVP) ---
# Usuario o email del admin para loguearse en /admin/login. Cualquier string no vacío.
ADMIN_EMAIL=hlstudio
# Password plaintext. Comparación con timingSafeEqual server-side.
# MVP: 1 solo admin, env var privada → plaintext es OK.
# Cuando migremos a multi-usuario, va a tabla `usuarios` + hashing real.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión (iron-session). 32+ chars random.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=

# --- Cancel tokens (links únicos firmados al cliente) ---
# Secreto HMAC para firmar tokens de cancelación de turno. 32+ chars random.
CANCEL_TOKEN_SECRET=

# --- Email (Resend) ---
# Free tier alcanza para arrancar.
# Dominio comprado: hlstudio.com.ar — verificar en Resend antes de usar en prod.
# - Mientras NO esté verificado: dejá `onboarding@resend.dev` (sandbox, sólo te llega a vos como owner de Resend).
# - Una vez verificado: cambiá a `reservas@hlstudio.com.ar`.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Nombre que aparece como remitente humano del email (opcional, default "HLstudio").
RESEND_FROM_NAME=HLstudio

# --- App ---
# URL pública para armar links absolutos en emails (sin trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zona horaria del local. No tocar hasta que haya multi-sucursal.
TIMEZONE=America/Argentina/Buenos_Aires

# --- WhatsApp bot (servicio Baileys interno) ---
# URL del bot WA. Si está vacía, las notificaciones siguen por email.
# Local (compose con profile wa): http://localhost:3001
# Coolify: http://hlstudio-whatsapp-bot:3001 (red interna entre servicios)
WHATSAPP_BOT_URL=
# Bearer compartido entre app y bot. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En dev se puede dejar vacío (el bot también lo permite vacío). En prod, SIEMPRE setearlo.
WHATSAPP_BOT_TOKEN=
